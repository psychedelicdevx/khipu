let N = 1000000

struct Point {
    x: number,
    y: number,
}

fn make(x: number, y: number) -> Point {
    return Point { x: x, y: y }
}

fn area(p: Point) -> number {
    return p.x * p.y
}

fn work(n: number) -> number {
    let point = make(3, 4)
    let total = 0
    let i = 0
    while i < n {
        total = total + area(point)
        i = i + 1
    }
    return total
}

print(work(N))
