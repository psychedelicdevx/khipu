let N = 60
let inside = 0
for py in range(N) {
    for px in range(N) {
        let cx = px * 3.0 / N - 2.0
        let cy = py * 2.0 / N - 1.0
        let x = 0
        let y = 0
        let i = 0
        while i < 50 && x * x + y * y <= 4 {
            let t = x * x - y * y + cx
            y = 2 * x * y + cy
            x = t
            i = i + 1
        }
        if i == 50 {
            inside = inside + 1
        }
    }
}
print(inside)
