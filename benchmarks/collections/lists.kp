let N = 300000

let items = [3, 4, 5, 6, 7, 8, 9, 10]

fn total(values: list<number>, rounds: number) -> number {
    let acc = 0
    let at = 0
    let n = len(values)
    while at < rounds {
        acc = acc + values[at % n]
        at = at + 1
    }
    values[0] = values[0] + 1
    return acc + values[len(values) - 1] + values[0]
}

print(total(items, N))
