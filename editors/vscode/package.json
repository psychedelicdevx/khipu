{
  "name": "khipu",
  "displayName": "Khipu",
  "description": "Khipu language support: highlighting, errors as you type, autocomplete, hover and formatting",
  "version": "0.2.2",
  "publisher": "psychedelicdevx",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "icon": "icons/khipu.png",
  "contributes": {
    "languages": [
      {
        "id": "khipu",
        "aliases": [
          "Khipu",
          "khipu"
        ],
        "extensions": [
          ".kp"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/kp.svg",
          "dark": "./icons/kp.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "khipu",
        "scopeName": "source.khipu",
        "path": "./syntaxes/khipu.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Khipu",
      "properties": {
        "khipu.path": {
          "type": "string",
          "default": "khipu",
          "description": "Path to the khipu executable used for the language server",
          "scope": "machine"
        }
      }
    }
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:khipu"
  ],
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "restrictedConfigurations": [
        "khipu.path"
      ]
    }
  }
}
