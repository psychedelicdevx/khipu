{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Khipu",
  "scopeName": "source.khipu",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#properties"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    },
    {
      "include": "#variables"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.khipu",
          "match": "//.*$"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.khipu",
          "match": "\\b(if|else|while|for|in|break|continue|return)\\b"
        },
        {
          "name": "storage.type.khipu",
          "match": "\\b(let|fn)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.khipu",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.khipu",
          "match": "\\bnone\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.khipu",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.khipu",
          "match": "\\b(print|len|push|range|keys)\\b(?=\\s*\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.optional.khipu",
          "match": "\\?\\?|\\?\\."
        },
        {
          "name": "keyword.operator.comparison.khipu",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.khipu",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.assignment.khipu",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.khipu",
          "match": "[-+*/%]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.block.khipu",
          "match": "[{}]"
        },
        {
          "name": "punctuation.section.parens.khipu",
          "match": "[()]"
        },
        {
          "name": "punctuation.section.brackets.khipu",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.separator.comma.khipu",
          "match": ","
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.khipu",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.khipu",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.khipu",
          "match": "\\\\[nt\"\\\\$]"
        },
        {
          "name": "meta.embedded.interpolation.khipu",
          "begin": "\\$\\{",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.begin.khipu"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.end.khipu"
            }
          },
          "contentName": "source.khipu",
          "patterns": [
            {
              "include": "$self"
            }
          ]
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.khipu"
            },
            "2": {
              "name": "entity.name.function.khipu"
            }
          }
        },
        {
          "name": "entity.name.function.call.khipu",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
        }
      ]
    },
    "properties": {
      "patterns": [
        {
          "match": "\\??\\.\\s*([A-Za-z_][A-Za-z0-9_]*)\\b(?!\\s*\\()",
          "captures": {
            "1": {
              "name": "variable.other.property.khipu"
            }
          }
        },
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(:)",
          "captures": {
            "1": {
              "name": "variable.other.property.khipu"
            },
            "2": {
              "name": "punctuation.separator.key-value.khipu"
            }
          }
        }
      ]
    }
  }
}
