#!/bin/sh
set -e

python3 scripts/sync-roadmap.py
git add ROADMAP.md README.md

cargo fmt --check
cargo clippy --quiet --all-targets -- -D warnings
cargo test --quiet
cargo build --quiet --release
find examples benchmarks -name '*.kp' -exec ./target/release/khipu fmt --check {} +
./target/release/khipu test examples/testing.kp > /dev/null
